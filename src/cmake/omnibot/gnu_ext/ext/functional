/*
 * Shim for the libstdc++-only header <ext/functional>, which does not exist
 * in Emscripten's libc++.  The Omni-Bot common.h includes it (alongside
 * <ext/hash_map>) only to pull __gnu_cxx::hash / __gnu_cxx::equal_to into
 * namespace stdext.  Provide those in terms of the standard equivalents.
 *
 * This file lives in a directory that is added to the omnibot_et include
 * path ahead of the system paths, so `#include <ext/functional>` resolves
 * here under Emscripten.  It is only on the include path for the SIDE_MODULE
 * target, never for the rest of the engine.
 */
#ifndef OB_SHIM_EXT_FUNCTIONAL
#define OB_SHIM_EXT_FUNCTIONAL

#include <functional>

namespace __gnu_cxx
{
	using std::equal_to;
	using std::less;
	using std::plus;
	using std::minus;
	using std::multiplies;
	using std::divides;
	using std::modulus;
	using std::negate;

	template <typename T>
	struct hash
	{
		size_t operator()(const T &v) const { return std::hash<T>()(v); }
	};

	template <>
	struct hash<const char *>
	{
		size_t operator()(const char *s) const
		{
			size_t h = 0;
			for (; *s; ++s)
				h = 5 * h + (unsigned char)*s;
			return h;
		}
	};

	template <>
	struct hash<char *>
	{
		size_t operator()(const char *s) const { return hash<const char *>()(s); }
	};
}

#endif /* OB_SHIM_EXT_FUNCTIONAL */
